<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Task Manager API — Muhammad Tayyab</title>
  <style>
    body { font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; margin: 0; background: #0f172a; color: #e2e8f0; }
    .wrap { max-width: 760px; margin: 0 auto; padding: 48px 24px; }
    h1 { font-size: 2rem; margin-bottom: 4px; }
    .sub { color: #94a3b8; margin-top: 0; }
    .badge { display: inline-block; padding: 4px 12px; border-radius: 999px; font-size: 0.85rem; background: #14532d; color: #bbf7d0; }
    .badge.db-down { background: #7f1d1d; color: #fecaca; }
    table { width: 100%; border-collapse: collapse; margin-top: 24px; }
    th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid #1e293b; font-size: 0.95rem; }
    th { color: #94a3b8; font-weight: 600; }
    code { background: #1e293b; padding: 2px 6px; border-radius: 6px; font-size: 0.85rem; }
    .method { font-weight: 700; }
    .get { color: #38bdf8; } .post { color: #4ade80; } .patch { color: #facc15; } .del { color: #f87171; }
    footer { margin-top: 40px; color: #64748b; font-size: 0.85rem; }
    a { color: #38bdf8; }
  </style>
</head>
<body>
  <div class="wrap">
    <h1>✅ Task Manager API</h1>
    <p class="sub">A REST API built with Node.js, Express &amp; MongoDB — by <strong>Muhammad Tayyab</strong></p>

    <p>
      <span class="badge">API is running</span>
      <% if (dbState === 'connected') { %>
        <span class="badge">Database: connected</span>
      <% } else { %>
        <span class="badge db-down">Database: not connected</span>
      <% } %>
    </p>

    <h2>Endpoints</h2>
    <table>
      <tr><th>Method</th><th>Route</th><th>Description</th><th>Auth</th></tr>
      <tr><td class="method post">POST</td><td><code>/api/auth/register</code></td><td>Register a new user</td><td>—</td></tr>
      <tr><td class="method post">POST</td><td><code>/api/auth/login</code></td><td>Login and receive a JWT</td><td>—</td></tr>
      <tr><td class="method get">GET</td><td><code>/api/auth/profile</code></td><td>Current user's profile</td><td>Bearer JWT</td></tr>
      <tr><td class="method post">POST</td><td><code>/api/tasks</code></td><td>Create a task</td><td>Bearer JWT</td></tr>
      <tr><td class="method get">GET</td><td><code>/api/tasks</code></td><td>List my tasks (filter + pagination)</td><td>Bearer JWT</td></tr>
      <tr><td class="method get">GET</td><td><code>/api/tasks/:id</code></td><td>Get one of my tasks</td><td>Bearer JWT</td></tr>
      <tr><td class="method patch">PATCH</td><td><code>/api/tasks/:id</code></td><td>Update a task</td><td>Bearer JWT</td></tr>
      <tr><td class="method del">DELETE</td><td><code>/api/tasks/:id</code></td><td>Delete a task</td><td>Bearer JWT</td></tr>
      <tr><td class="method get">GET</td><td><code>/health</code></td><td>Service health check</td><td>—</td></tr>
    </table>

    <footer>
      Health check: <a href="/health">/health</a> · Built with the MERN stack ·
      Routes → Middleware → Controllers → Services → Database
    </footer>
  </div>
</body>
</html>
